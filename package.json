{
  "name": "goatmaster",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "docs:html": "bun scripts/build-docs-html.mjs",
    "db:migrate": "bun scripts/migrate.js",
    "db:seed:admin": "bun scripts/create-admin.js",
    "proto:gen": "bunx buf generate --template packages/api-contracts/buf.gen.ts.yaml packages/api-contracts",
    "proto:gen:ts": "bunx buf generate --template packages/api-contracts/buf.gen.ts.yaml packages/api-contracts",
    "proto:gen:py": "bunx buf generate --template packages/api-contracts/buf.gen.py.yaml packages/api-contracts",
    "proto:lint": "bunx buf lint packages/api-contracts",
    "proto:breaking": "bunx buf breaking packages/api-contracts",
    "typecheck": "bun scripts/typecheck.js",
    "db:seed:sample": "bun scripts/seed-sample-data.js",
    "db:rls": "bun scripts/apply-rls.js",
    "jobs:reminders": "bun scripts/generate-reminders.js",
    "test": "bun test --preload ./scripts/tests/env.ts scripts/tests",
    "verify:e2e": "bun scripts/verify-e2e.mjs"
  },
  "dependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protoc-gen-connect-es": "^0.13.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sentry/nextjs": "^11.9.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "file-saver": "^2.0.5",
    "gsap": "^3.15.0",
    "idb": "^8.0.3",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "pg": "^8.16.3",
    "postcss": "^8.5.31",
    "posthog-js": "^1.438.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "marked": "^18.1.1",
    "playwright": "^1.64.1",
    "typescript": "5.5"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.0"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "sharp": "^0.35.5"
  }
}
